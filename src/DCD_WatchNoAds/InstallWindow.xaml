<Window x:Class="DCDWatch.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài DCD_WatchNoAds" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}" FontSize="13" Icon="appicon.ico"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">

  <StackPanel Margin="26,22,26,22">
    <StackPanel Orientation="Horizontal">
      <Image Source="appicon.ico" Width="44" Height="44"/>
      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="DCD_WatchNoAds" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="LblVersion" Foreground="{StaticResource Muted}" FontSize="12"/>
      </StackPanel>
    </StackPanel>

    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="20"
               Text="Trình duyệt xem phim không quảng cáo — chặn lén nên trang không bắt tắt adblock."/>

    <Border Margin="0,16,0,0" Background="{StaticResource Sunken}" CornerRadius="8" Padding="12,9">
      <StackPanel>
        <TextBlock Text="Cài vào" Foreground="{StaticResource Faint}" FontSize="11.5"/>
        <TextBlock x:Name="LblDir" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <CheckBox x:Name="ChkDesktop" Margin="0,14,0,0" IsChecked="True" Content="Tạo shortcut ngoài Desktop"/>

    <TextBlock x:Name="LblError" Margin="0,12,0,0" Foreground="{StaticResource Bad}"
               TextWrapping="Wrap" Visibility="Collapsed"/>

    <Grid Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BtnInstall" Grid.Column="0" Content="Cài đặt" Padding="16,10"
              Style="{StaticResource BtnBase}" Background="{StaticResource Go}" Click="BtnInstall_Click"/>
      <Button Grid.Column="2" Content="Chạy luôn, không cài" Padding="14,10"
              Style="{StaticResource BtnGhost}" Click="BtnRun_Click"/>
    </Grid>
  </StackPanel>
</Window>
